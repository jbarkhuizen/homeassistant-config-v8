# ==============================================================================
# Prepaid Meter Recharge — Sync & Notification
# File: automations/prepaid_meter_recharge.yaml
# Updated: 2026-05-01
# Original source: https://github.com/tomatensaus/DeyeSolarDesktop/blob/main/packages/prepaidmeter_automations.yaml
# Purpose: When prepaid meter units are recharged (input_number.prepaid_meter_units
#          increases), sync the inverter total units counter and notify all channels.
# Channels: Email | Telegram | Mobile Push (SM-G996B) | Persistent | System Log
# ==============================================================================

- id: prepaid_meter_recharge_sync
  alias: "Prepaid Meter: Recharge Detected — Sync & Notify"
  description: >
    Triggers when input_number.prepaid_meter_units changes to a higher value
    (recharge detected). Syncs the inverter total units counter and sends
    notifications via Email, Telegram, Mobile Push, Persistent and System Log.

  trigger:
    - platform: state
      entity_id: input_number.prepaid_meter_units

  condition:
    # Only process if the new value is greater than zero
    - condition: template
      value_template: "{{ states('input_number.prepaid_meter_units') | float(0) > 0 }}"
    # Only process if the new value is higher than the old value (actual recharge, not a reset)
    - condition: template
      value_template: "{{ trigger.to_state.state | float(0) > trigger.from_state.state | float(0) }}"

  action:
    # Variables for notifications
    - variables:
        new_units: "{{ trigger.to_state.state | float(0) | round(2) }}"
        old_units: "{{ trigger.from_state.state | float(0) | round(2) }}"
        units_added: "{{ (trigger.to_state.state | float(0) - trigger.from_state.state | float(0)) | round(2) }}"
        inverter_total_raw: "{{ states('sensor.deyeinvertermaster_summary_total_grid_import_buy') | float(6) }}"
        inverter_total_wh: "{{ (inverter_total_raw * 1000.0) | round(0) }}"
        current_balance: >-
          {% set v = states('sensor.prepaid_units_left') %}
          {% if v in ['unknown','unavailable','None',''] %}N/A{% else %}{{ v | float(0) | round(2) }} kWh{% endif %}
        daily_usage: >-
          {% set v = states('sensor.deyeinvertermaster_summary_daily_grid_import_buy') %}
          {% if v in ['unknown','unavailable','None',''] %}N/A{% else %}{{ v | float(0) | round(2) }} kWh{% endif %}
        days_remaining: >-
          {% set bal = states('sensor.prepaid_units_left') | float(0) %}
          {% set daily = states('sensor.deyeinvertermaster_summary_daily_grid_import_buy') | float(1) %}
          {% if daily > 0 %}{{ (bal / daily) | round(1) }} days{% else %}N/A{% endif %}

    # Sync the inverter total units counter
    - service: input_number.set_value
      data:
        value: "{{ inverter_total_wh }}"
      target:
        entity_id: input_number.prepaid_meter_inverter_total_units

    # --- Persistent Notification ---
    - service: persistent_notification.create
      data:
        title: "💳 Prepaid Meter Recharged — {{ units_added }} kWh Added ({{ now().strftime('%d %b %Y %H:%M') }})"
        message: >-
          Prepaid meter recharge detected at {{ now().strftime('%Y-%m-%d %H:%M:%S') }}.

          💳 Recharge Summary:
          • Units Added: {{ units_added }} kWh
          • Previous Balance: {{ old_units }} kWh
          • New Balance: {{ new_units }} kWh
          • Current Remaining: {{ current_balance }}
          • Estimated Days Remaining: {{ days_remaining }}
          • Yesterday's Usage: {{ daily_usage }}

          🔄 Inverter Counter Synced:
          • input_number.prepaid_meter_inverter_total_units set to {{ inverter_total_wh }} Wh

          🌐 192.168.1.31:8123
        notification_id: "prepaid_meter_recharge_sync"

    # --- Telegram ---
    - service: telegram_bot.send_message
      data:
        chat_id: !secret telegram_chat_id_2
        message: >-
          💳 *Prepaid Meter Recharged*

          ✅ Units Added: *{{ units_added }} kWh*
          📊 Previous: {{ old_units }} kWh → New: {{ new_units }} kWh
          🔋 Current Balance: {{ current_balance }}
          ⏳ Days Remaining: {{ days_remaining }}
          📅 Yesterday's Usage: {{ daily_usage }}

          🔄 Inverter counter synced to {{ inverter_total_wh }} Wh.
          _{{ now().strftime('%Y-%m-%d %H:%M:%S') }}_
          🌐 192.168.1.31:8123
        parse_mode: markdown

    # --- Email ---
    - service: notify.email_ha
      data:
        title: "💳 Prepaid Meter Recharged — {{ units_added }} kWh Added ({{ now().strftime('%Y-%m-%d %H:%M') }})"
        message: >-
          PREPAID METER RECHARGE DETECTED

          Date: {{ now().strftime('%A, %d %B %Y at %H:%M:%S') }}

          ================================================================================

          RECHARGE SUMMARY

          Units Added: {{ units_added }} kWh
          Previous Balance: {{ old_units }} kWh
          New Balance: {{ new_units }} kWh
          Current Remaining: {{ current_balance }}
          Estimated Days Remaining: {{ days_remaining }}
          Yesterday's Usage: {{ daily_usage }}

          INVERTER COUNTER SYNC

          input_number.prepaid_meter_inverter_total_units has been automatically
          updated to {{ inverter_total_wh }} Wh to reflect the current inverter
          grid import total from sensor.deyeinvertermaster_summary_total_grid_import_buy.

          ================================================================================

          System: http://192.168.1.31:8123
          Cloud: https://gy98slwcfto2t5oia2xnqjeabx480gs6.ui.nabu.casa/

    # --- Mobile Push ---
    - service: notify.mobile_app_sm_g996b
      data:
        title: "💳 Prepaid Meter Recharged — {{ units_added }} kWh Added"
        message: >-
          Balance: {{ old_units }} → {{ new_units }} kWh (+{{ units_added }} kWh).
          Remaining: {{ current_balance }} (~{{ days_remaining }}).
          Inverter counter synced ✅
        data:
          channel: "Prepaid Meter"
          importance: default
          group: "ha-prepaid"
          color: "#4CAF50"
          icon_url: "https://www.home-assistant.io/images/favicon-192x192-full.png"
          actions:
            - action: "OPEN_HA"
              title: "Open HA"
              uri: "http://192.168.1.31:8123"

    # --- System Log ---
    - service: system_log.write
      data:
        message: >-
          Prepaid Meter Recharge: {{ units_added }} kWh added
          ({{ old_units }} → {{ new_units }} kWh).
          Current balance: {{ current_balance }}, Days remaining: {{ days_remaining }}.
          Inverter counter synced to {{ inverter_total_wh }} Wh.
          Channels: Email, Telegram, Mobile Push (SM-G996B), Persistent.
        level: info

  mode: single
# ==============================================================================
# END OF PREPAID METER RECHARGE SYNC
# ==============================================================================