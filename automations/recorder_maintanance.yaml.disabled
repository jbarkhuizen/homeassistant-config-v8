# ==============================================================================
# Recorder & Database Health Maintenance
# File: automations/recorder_maintanance.yaml
# Updated: 2026-05-01
#
# Daily at 09:00:
#   - Compare current DB size vs baseline (baseline stored at previous 09:00)
#   - If percent growth > threshold (input_number.homeassistant_db_growth_threshold_percent)
#     AND absolute increase > 250 MB:
#       -> Notify all channels
#       -> Trigger recorder.purge (keep_days: 30, repack: true)
#   - Update baseline to current size
#
# Startup:
#   - Initialize baseline if zero and DB size > 0
#
# Entities required:
#   sensor.homeassistant_db_size_mb
#   input_number.homeassistant_db_baseline_mb
#   input_number.homeassistant_db_growth_threshold_percent
#
# Services used:
#   recorder.purge
# Channels: Email | Telegram | Mobile Push (SM-G996B) | Persistent | System Log
# ==============================================================================

#------------------------------------------------------------------------------
# Automation 1: Initialize DB baseline on HA startup
#------------------------------------------------------------------------------
- id: recorder_db_baseline_init_startup
  alias: "Recorder: Initialize DB Baseline on Startup"
  description: >
    On HA startup, if the stored baseline is 0 and the DB size sensor is available,
    set the baseline to the current DB size to ensure a clean starting point
    for the daily growth check.

  trigger:
    - platform: homeassistant
      event: start

  condition:
    # Only initialize if baseline is currently 0
    - condition: template
      value_template: "{{ states('input_number.homeassistant_db_baseline_mb') | float(0) == 0 }}"
    # Only if DB size sensor is available and > 0
    - condition: template
      value_template: "{{ states('sensor.homeassistant_db_size_mb') | float(0) > 0 }}"

  action:
    - variables:
        db_size: "{{ states('sensor.homeassistant_db_size_mb') | float(0) | round(1) }}"

    # Set baseline to current DB size
    - service: input_number.set_value
      target:
        entity_id: input_number.homeassistant_db_baseline_mb
      data:
        value: "{{ db_size }}"

    # --- Persistent Notification ---
    - service: persistent_notification.create
      data:
        title: "🗄️ Recorder DB Baseline Initialised"
        message: >-
          Recorder database baseline initialised at startup on {{ now().strftime('%Y-%m-%d %H:%M:%S') }}.

          🗄️ Baseline set to: {{ db_size }} MB
          📋 Daily growth check runs at 09:00.
          📊 Alert triggers when growth exceeds configured threshold AND absolute increase > 250 MB.
        notification_id: "recorder_db_baseline_init"

    # --- System Log ---
    - service: system_log.write
      data:
        message: >-
          Recorder DB baseline initialised on startup to {{ db_size }} MB.
        level: info

  mode: single

#------------------------------------------------------------------------------
# Automation 2: Daily DB Growth Check at 09:00
#------------------------------------------------------------------------------
- id: recorder_db_daily_growth_check_0900
  alias: "Recorder: Daily DB Growth Check (09:00) — All Channels"
  description: >
    At 09:00, compares current DB size vs the stored baseline.
    If percent growth exceeds the configured threshold AND absolute growth
    exceeds 250 MB, notifies all channels and triggers recorder.purge.
    Always updates the baseline after the check.
    Channels: Email, Telegram, Mobile Push (SM-G996B), Persistent, System Log.

  trigger:
    - platform: time
      at: "09:00:00"

  condition: []

  action:
    - variables:
        db_now: "{{ states('sensor.homeassistant_db_size_mb') | float(0) | round(1) }}"
        db_baseline: "{{ states('input_number.homeassistant_db_baseline_mb') | float(0) | round(1) }}"
        threshold_pct: "{{ states('input_number.homeassistant_db_growth_threshold_percent') | float(20) }}"
        growth_mb: "{{ (db_now - db_baseline) | round(1) }}"
        growth_pct: >-
          {% if db_baseline > 0 %}
            {{ ((db_now - db_baseline) / db_baseline * 100) | round(1) }}
          {% else %}
            0
          {% endif %}
        alert_needed: "{{ growth_pct | float(0) > threshold_pct | float(20) and growth_mb | float(0) > 250 }}"
        risk_level: >-
          {% set pct = growth_pct | float(0) %}
          {% if pct >= threshold_pct | float(20) * 2 %}CRITICAL
          {% elif pct >= threshold_pct | float(20) %}HIGH
          {% else %}NORMAL
          {% endif %}
        alert_color: >-
          {% if risk_level == 'CRITICAL' %}#B71C1C
          {% elif risk_level == 'HIGH' %}#FF9800
          {% else %}#4CAF50
          {% endif %}

    - choose:
        #----------------------------------------------------------------------
        # BRANCH 1: Growth threshold exceeded — notify and purge
        #----------------------------------------------------------------------
        - conditions:
            - condition: template
              value_template: "{{ alert_needed == true or alert_needed == 'True' }}"
          sequence:
            # --- Persistent Notification ---
            - service: persistent_notification.create
              data:
                title: "🗄️ Recorder DB Growth Alert — {{ risk_level }} (09:00 {{ now().strftime('%d %b %Y') }})"
                message: >-
                  Recorder database growth alert at {{ now().strftime('%Y-%m-%d %H:%M:%S') }}.

                  🗄️ Database Growth Details:
                  • Current Size: {{ db_now }} MB
                  • Baseline (yesterday): {{ db_baseline }} MB
                  • Growth: {{ growth_mb }} MB ({{ growth_pct }}%)
                  • Threshold: {{ threshold_pct }}%
                  • Risk Level: {{ risk_level }}

                  🔧 Action Taken:
                  • recorder.purge triggered (keep_days: 30, repack: true)

                  ⚠️ Recommended Follow-Up:
                  • Monitor DB size over the next 24 hours
                  • If growth persists, consider reducing recorder keep_days in configuration.yaml
                  • Check for high-frequency entity state changes in Developer Tools → Statistics

                  🌐 192.168.1.31:8123
                notification_id: "recorder_db_growth_alert"

            # --- Telegram ---
            - service: telegram_bot.send_message
              data:
                chat_id: !secret telegram_chat_id_2
                message: >-
                  🗄️ *Recorder DB Growth Alert — {{ risk_level }}*

                  📊 DB: {{ db_now }} MB (was {{ db_baseline }} MB)
                  📈 Growth: {{ growth_mb }} MB ({{ growth_pct }}% — threshold: {{ threshold_pct }}%)
                  ⚠️ Risk Level: *{{ risk_level }}*

                  🔧 recorder.purge triggered (keep_days: 30, repack: true).
                  Monitor DB size over the next 24 hours.
                  _{{ now().strftime('%Y-%m-%d %H:%M:%S') }}_
                  🌐 192.168.1.31:8123
                parse_mode: markdown

            # --- Email ---
            - service: notify.email_ha
              data:
                title: "🗄️ Recorder DB Growth Alert — {{ risk_level }} ({{ now().strftime('%Y-%m-%d') }})"
                message: >-
                  RECORDER DATABASE GROWTH ALERT

                  Date: {{ now().strftime('%A, %d %B %Y at %H:%M:%S') }}

                  ================================================================================

                  ALERT DETAILS

                  Risk Level: {{ risk_level }}
                  Current DB Size: {{ db_now }} MB
                  Baseline (yesterday): {{ db_baseline }} MB
                  Growth: {{ growth_mb }} MB ({{ growth_pct }}%)
                  Growth Threshold: {{ threshold_pct }}%
                  Absolute Growth Threshold: 250 MB

                  ACTION TAKEN:
                  recorder.purge has been triggered automatically with:
                  - keep_days: 30
                  - repack: true

                  This will remove history older than 30 days and compact the database.
                  The process runs in the background and may take several minutes.

                  RECOMMENDED FOLLOW-UP:
                  1. Monitor DB size in the next 24 hours to confirm reduction
                  2. If growth persists, consider reducing recorder keep_days in configuration.yaml
                  3. Check Developer Tools → Statistics for high-frequency entities
                  4. Consider excluding non-essential entities from recorder

                  ================================================================================

                  System: http://192.168.1.31:8123
                  Cloud: https://gy98slwcfto2t5oia2xnqjeabx480gs6.ui.nabu.casa/

            # --- Mobile Push ---
            - service: notify.mobile_app_sm_g996b
              data:
                title: "🗄️ Recorder DB Growth — {{ risk_level }}"
                message: >-
                  DB: {{ db_now }} MB (+{{ growth_mb }} MB / {{ growth_pct }}%, threshold {{ threshold_pct }}%).
                  Auto-purge triggered (keep 30 days). Monitor over next 24h.
                data:
                  channel: "System Health"
                  importance: high
                  group: "ha-system-health"
                  color: "{{ alert_color }}"
                  icon_url: "https://www.home-assistant.io/images/favicon-192x192-full.png"
                  actions:
                    - action: "OPEN_HA"
                      title: "Open HA"
                      uri: "http://192.168.1.31:8123"

            # --- System Log ---
            - service: system_log.write
              data:
                message: >-
                  Recorder DB Growth Alert: {{ db_now }} MB (was {{ db_baseline }} MB),
                  growth {{ growth_mb }} MB ({{ growth_pct }}%, threshold {{ threshold_pct }}%),
                  risk {{ risk_level }}. recorder.purge triggered.
                  Channels: Email, Telegram, Mobile Push (SM-G996B), Persistent.
                level: warning

            # Trigger recorder purge
            - service: recorder.purge
              data:
                keep_days: 30
                repack: true

        #----------------------------------------------------------------------
        # BRANCH 2: Growth within normal limits — log only
        #----------------------------------------------------------------------
        - conditions:
            - condition: template
              value_template: "{{ alert_needed == false or alert_needed == 'False' }}"
          sequence:
            # --- Persistent Notification ---
            - service: persistent_notification.create
              data:
                title: "✅ Recorder DB Growth OK (09:00 {{ now().strftime('%d %b %Y') }})"
                message: >-
                  Daily recorder DB growth check at {{ now().strftime('%Y-%m-%d %H:%M:%S') }}.

                  ✅ Growth within normal limits.

                  🗄️ DB Status:
                  • Current Size: {{ db_now }} MB
                  • Baseline (yesterday): {{ db_baseline }} MB
                  • Growth: {{ growth_mb }} MB ({{ growth_pct }}%)
                  • Threshold: {{ threshold_pct }}% — Status: NORMAL

                  No purge required.
                notification_id: "recorder_db_growth_ok"

            # --- System Log ---
            - service: system_log.write
              data:
                message: >-
                  Recorder DB growth OK at 09:00: {{ db_now }} MB (was {{ db_baseline }} MB),
                  growth {{ growth_mb }} MB ({{ growth_pct }}%, threshold {{ threshold_pct }}%). No purge required.
                level: info

    # Always update baseline to current size after the check
    - service: input_number.set_value
      target:
        entity_id: input_number.homeassistant_db_baseline_mb
      data:
        value: "{{ db_now }}"

  mode: single
# ==============================================================================
# END OF RECORDER & DATABASE HEALTH MAINTENANCE
# ==============================================================================